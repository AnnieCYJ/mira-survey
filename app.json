{
  "expo": {
    "name": "miraringfashion",
    "slug": "miraringfashion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "miraringfashion",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miraringfashion.app",
      "buildNumber": "1",
      "deploymentTarget": "13.4",
      "infoPlist": {
        "NSHealthShareUsageDescription": "miraringfashion 读取你的睡眠与心率数据用于生成每日状态。",
        "NSBluetoothAlwaysUsageDescription": "miraringfashion 需要通过蓝牙连接你的智能戒指以采集周期、睡眠与心率数据。",
        "NSBluetoothPeripheralUsageDescription": "miraringfashion 需要通过蓝牙连接你的智能戒指以采集周期、睡眠与心率数据。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral",
          "fetch"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {}
        },
        "NSMicrophoneUsageDescription": "Mira 需要访问麦克风以支持语音输入。",
        "NSSpeechRecognitionUsageDescription": "Mira 需要语音识别权限以将你的语音转换成文字。"
      }
    },
    "android": {
      "package": "com.miraringfashion.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "./plugins/withVeepooSDK",
      [
        "expo-build-properties",
        {
          "ios": {
            "forceCxx20": true
          }
        }
      ],
      [
        "./plugins/withLlamaRN",
        {
          "forceCxx20": true
        }
      ],
      "./plugins/withMetroScheme",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Mira 需要访问麦克风以支持语音输入。",
          "speechRecognitionPermission": "Mira 需要语音识别权限以将你的语音转换成文字。"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}