{
  "expo": {
    "name": "miraringfashion",
    "slug": "miraringfashion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "miraringfashion",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miraringfashion.app",
      "buildNumber": "1",
      "deploymentTarget": "13.4",
      "infoPlist": {
        "NSHealthShareUsageDescription": "miraringfashion \u8bfb\u53d6\u4f60\u7684\u7761\u7720\u4e0e\u5fc3\u7387\u6570\u636e\u7528\u4e8e\u751f\u6210\u6bcf\u65e5\u72b6\u6001\u3002",
        "NSBluetoothAlwaysUsageDescription": "miraringfashion \u9700\u8981\u901a\u8fc7\u84dd\u7259\u8fde\u63a5\u4f60\u7684\u667a\u80fd\u6212\u6307\u4ee5\u91c7\u96c6\u5468\u671f\u3001\u7761\u7720\u4e0e\u5fc3\u7387\u6570\u636e\u3002",
        "NSBluetoothPeripheralUsageDescription": "miraringfashion \u9700\u8981\u901a\u8fc7\u84dd\u7259\u8fde\u63a5\u4f60\u7684\u667a\u80fd\u6212\u6307\u4ee5\u91c7\u96c6\u5468\u671f\u3001\u7761\u7720\u4e0e\u5fc3\u7387\u6570\u636e\u3002",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral",
          "fetch"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {}
        }
      }
    },
    "android": {
      "package": "com.miraringfashion.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "./plugins/withVeepooSDK",
      [
        "expo-build-properties",
        {
          "ios": {
            "forceCxx20": true
          }
        }
      ],
      [
        "./plugins/withLlamaRN",
        {
          "forceCxx20": true
        }
      ],
      "./plugins/withMetroScheme"
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}