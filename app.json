{
  "expo": {
    "name": "miraringfashion",
    "slug": "miraringfashion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "miraringfashion",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miraringfashion.app",
      "buildNumber": "1",
      "deploymentTarget": "13.4",
      "infoPlist": {
        "NSHealthShareUsageDescription": "miraringfashion 读取你的睡眠与心率数据用于生成每日状态。",
        "NSBluetoothAlwaysUsageDescription": "miraringfashion 需要通过蓝牙连接你的智能戒指以采集周期、睡眠与心率数据。",
        "NSBluetoothPeripheralUsageDescription": "miraringfashion 需要通过蓝牙连接你的智能戒指以采集周期、睡眠与心率数据。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral",
          "fetch"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {}
        },
        "NSMicrophoneUsageDescription": "Mira 需要访问麦克风以支持语音输入。",
        "NSMotionUsageDescription": "miraringfashion 读取运动与步数数据用于计算每日活动量与状态分析。",
        "NSSpeechRecognitionUsageDescription": "Mira 需要语音识别权限以将你的语音转换成文字。"
      }
    },
    "android": {
      "package": "com.miraringfashion.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withVeepooSDK",
      "./plugins/withVeepooSDKAndroid",
      [
        "expo-image-picker",
        {
          "cameraPermission": "用于拍摄餐食照片，识别菜品并记录热量",
          "photosPermission": "用于选择餐食照片，识别菜品并记录热量",
          "savePhotosPermission": "用于保存餐食照片到相册"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "forceCxx20": true
          }
        }
      ],
      "./plugins/withMetroScheme",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Mira 需要访问麦克风以支持语音输入。",
          "speechRecognitionPermission": "Mira 需要语音识别权限以将你的语音转换成文字。"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "a0f991e3-cd0e-4fe2-ab83-2dd215f2748c"
      }
    }
  }
}
