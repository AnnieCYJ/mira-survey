android/
# 注意：原生桥源码（*.kt / AndroidManifest.xml / res/*.xml / app/build.gradle）已用
#   `git add -f` 显式跟踪。忽略规则对已跟踪文件无效，后续改动会正常出现在 git status。
#   新增原生源码文件时同样需要 git add -f。构建产物 / SDK aar / .so / 密钥仍被忽略。
.DS_Store
.env

# ★ 2026-11-15 正式 release 签名密钥与口令：绝不入库。
#   本地副本在 ~/.android-toolchain/keystore-backup/，丢失将无法发布任何升级包。
android/app/*.keystore
**/keystore.properties

# 端侧 LLM 模型权重（1.1GB，本地构建用，不进 git）
*.gguf
assets/models/

# Xcode 构建中间产物副本（~3.3GB，本地构建用，不进 git）
build_fresh/

# Hermes 引擎构建产物与 Xcode 构建配置（构建中间产物，不进 git）
hermes-engine/
.last_build_configuration

# OTA 发布产物：APK 约 341 MB，绝不进 git；清单 update.json 保留（几百字节）
dist-update/*.apk
dist-update/app-debug.apk

# 本地 APK 构建产物（约 2.9G）、真机验证证据、临时源码备份：不进源码仓库
apk/
_qa/
*.bak-*
